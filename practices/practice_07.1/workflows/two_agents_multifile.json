    {
      "parameters": {
        "jsCode": "const { data, readme } = $input.first().json;\nif (typeof data !== 'string') throw new Error('Ожидался diff в поле data');\n\nconst blocks = [];\nlet oldPath = null, newPath = null, hunk = null;\n\nfunction pathOf(value) {\n  if (value.startsWith('\"')) value = JSON.parse(value);\n  return value === '/dev/null' ? null : value.replace(/^[ab]\\//, '');\n}\n\nfunction finish() {\n  if (!hunk) return;\n  const anchor = hunk.added ?? hunk.deleted;\n  if (anchor) {\n    const path = newPath ?? oldPath;\n    if (!path) throw new Error('Не найден путь файла');\n    blocks.push({\n      id: 'h' + (blocks.length + 1),\n      path,\n      ...anchor,\n      diff: hunk.lines.join('\\n'),\n    });\n  }\n  hunk = null;\n}\n\nfor (const line of data.split('\\n')) {\n  if (line.startsWith('diff --git ')) {\n    finish();\n    oldPath = newPath = null;\n    continue;\n  }\n\n  const match = line.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n  if (match) {\n    finish();\n    hunk = { old: Number(match[1]), new: Number(match[2]), lines: [line] };\n    continue;\n  }\n\n  if (!hunk) {\n    if (line.startsWith('--- ')) oldPath = pathOf(line.slice(4));\n    if (line.startsWith('+++ ')) newPath = pathOf(line.slice(4));\n    continue;\n  }\n\n  if (!line) continue;\n  hunk.lines.push(line);\n\n  if (line.startsWith('+')) {\n    hunk.added ??= { line: hunk.new, side: 'RIGHT' };\n    hunk.new++;\n  } else if (line.startsWith('-')) {\n    hunk.deleted ??= { line: hunk.old, side: 'LEFT' };\n    hunk.old++;\n  } else if (line.startsWith(' ')) {\n    hunk.old++;\n    hunk.new++;\n  }\n}\n\nfinish();\nif (!blocks.length) throw new Error('В diff нет текстовых блоков изменений');\nreturn [{ json: { readme, blocks } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -32
      ],
      "id": "d0bdb237-bacb-42a3-aa82-b8c7350af953",
      "name": "Split diff",
      "notesInFlow": true,
      "notes": "Splitting diff into files"
    },
    {
      "parameters": {
        "jsCode": "const blocks = $('Split diff').first().json.blocks;\nlet result = $input.first().json.output;\n\nif (typeof result === 'string') {\n  result = JSON.parse(result.trim()\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, ''));\n}\n\nif (!Array.isArray(result?.comments)\n    || result.comments.length !== blocks.length) {\n  throw new Error('Нужен ровно один комментарий на каждый блок diff');\n}\n\nconst ids = new Set(blocks.map(block => block.id));\nconst byId = new Map();\n\nfor (const comment of result.comments) {\n  if (!ids.has(comment.block_id) || byId.has(comment.block_id)\n      || typeof comment.body !== 'string' || !comment.body.trim()) {\n    throw new Error('Неверный id блока, повтор или пустой комментарий');\n  }\n  byId.set(comment.block_id, comment.body.trim());\n}\n\nconst pr = $('Get PR details').first().json;\nconst command = $('Command Trigger').first().json.body.comment.body.trim();\nconst model = command === '/make_other_ai_review'\n  ? 'anthropic/claude-sonnet-4.5' : 'openai/gpt-5';\n\nreturn [{\n  json: {\n    commit_id: pr.head.sha,\n    event: 'COMMENT',\n    body: 'Модель: ' + model + '. Проверено блоков: ' + blocks.length + '.',\n    comments: blocks.map(block => ({\n      path: block.path,\n      line: block.line,\n      side: block.side,\n      body: byId.get(block.id),\n    })),\n  },\n}];"
      },
