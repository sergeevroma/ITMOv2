+/**
+ * OpenCode plugin: check-after-edit
+ *
+ * Запускает sh scripts/check.sh из каталога room_booking_project текущего worktree
+ * после изменений Python-файлов инструментами агента (edit/write/apply_patch).
+ * Выполняет проверки последовательно, с тайм-аутом 30 секунд.
+ * Возвращает PASS/FAIL, код завершения и вывод проверки в результате инструмента.
+ */
+
+/** @type {import('@opencode-ai/plugin').Plugin} */
+export default async ({ project, directory, client, $ }) => {
+  const isPython = (path) => path.endsWith('.py');
+
+  async function runChecks(cwd) {
+    const cmd = 'sh scripts/check.sh';
+    const timeoutMs = 30_000;
+    const workdir = `${cwd}/room_booking_project`;
+    const start = Date.now();
+    try {
+      const result = await $.bash(cmd, { cwd: workdir, timeout: timeoutMs });
+      const duration = Date.now() - start;
+      return { ok: result.code === 0, code: result.code, stdout: result.stdout, stderr: result.stderr, duration };
+    } catch (err) {
+      return { ok: false, code: err.code ?? 1, stdout: err.stdout ?? '', stderr: String(err.stderr ?? err.message ?? err), duration: Date.now() - start };
+    }
+  }
+
+  return {
+    async 'tool.execute.after'(input, output) {
+      const tool = input.tool;
+      const edited = output?.edited_files ?? [];
+      const wrote = output?.written_files ?? [];
+      const files = [...edited, ...wrote];
+      if (!files.some(isPython)) return;
+
+      const res = await runChecks(directory);
+      const summary = res.ok ? 'PASS' : 'FAIL';
+      // Поверх результата инструмента добавляем отчёт
+      output.check_after_edit = {
+        status: summary,
+        code: res.code,
+        duration_ms: res.duration,
+        stdout: res.stdout,
+        stderr: res.stderr,
+      };
+      if (!res.ok) {
+        // Сигнализируем о провале в явном виде
+        throw new Error(`check-after-edit: ${summary} (code ${res.code})`);
+      }
+    },
+  };
+};

