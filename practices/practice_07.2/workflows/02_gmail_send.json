      "id": "dad7ffb6-27f6-4f2b-a4d4-1ba05cad9648",
      "name": "Call Weekly Analysis"
    },
    {
      "parameters": {
        "jsCode": "const { current, previous, delta, ai_comment } = $input.first().json;\nconst isTest = $(\"Period\").first().json.is_test;\nconst escapeHtml = value => String(value).replace(/[&<>\"']/g, char => ({\n  \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\",\n}[char]));\nconst showDelta = value => value === null ? \"—\" : value > 0 ? `+${value}` : String(value);\nconst formatDate = value => value.split(\"-\").reverse().join(\".\");\nconst lastDay = new Date(current.week_end + \"T00:00:00Z\");\nlastDay.setUTCDate(lastDay.getUTCDate() - 1);\nconst period = `${formatDate(current.week_start)}–${formatDate(lastDay.toISOString().slice(0, 10))}`;\n\nconst types = [\"bug\", \"feature\", \"task\", \"unknown\"];\nconst typeRows = types.map(type => `<tr>\n  <td>${type === \"unknown\" ? \"unknown (needs-triage)\" : type}</td>\n  <td>${current.by_type[type] ?? 0}</td>\n  <td>${previous ? previous.by_type[type] ?? 0 : \"—\"}</td>\n  <td>${showDelta(delta.by_type[type])}</td>\n</tr>`).join(\"\");\nconst authorRows = Object.keys(delta.by_author).map(author => `<tr>\n  <td>${escapeHtml(author)}</td>\n  <td>${current.by_author[author] ?? 0}</td>\n  <td>${previous ? previous.by_author[author] ?? 0 : \"—\"}</td>\n  <td>${showDelta(delta.by_author[author])}</td>\n</tr>`).join(\"\");\nconst table = (heading, rows) => `<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n  <thead><tr><th>${heading}</th><th>Отчётная неделя</th><th>Предыдущая неделя</th><th>Δ</th></tr></thead>\n  <tbody>${rows}</tbody></table>`;\n\nconst html = `<html><body>\n  <h2>Tiny Notes: ${period}</h2>\n  <p>Всего обращений: <b>${current.total}</b>.\n  Предыдущая неделя: ${previous ? previous.total : \"нет данных\"}.\n  Δ: ${showDelta(delta.total)}.</p>\n  <h3>По типам</h3>${table(\"Тип\", typeRows)}\n  <h3>По авторам</h3>${table(\"Автор\", authorRows)}\n  <h3>AI-комментарий недели</h3>\n  <p>${escapeHtml(ai_comment).replace(/\\r?\\n/g, \"<br>\")}</p>\n</body></html>`;\n\nreturn [{ json: {\n  subject: `${isTest ? \"[ТЕСТ] \" : \"\"}Tiny Notes — отчёт за ${period}`,\n  html,\n} }];\n"
      },
