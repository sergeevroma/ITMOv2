    {
      "parameters": {
        "jsCode": "const period = $(\"Period\").first().json;\nconst rows = $input.all().map(item => item.json).filter(row => row.issue_id);\nconst byType = { bug: 0, feature: 0, task: 0, unknown: 0 };\nconst byAuthor = {};\n\nfor (const row of rows) {\n  byType[row.type] += 1;\n  byAuthor[row.author] = (byAuthor[row.author] ?? 0) + 1;\n}\n\nreturn [{ json: {\n  week_start: period.week_start,\n  week_end: period.week_end,\n  total: rows.length,\n  by_type_json: JSON.stringify(byType),\n  by_author_json: JSON.stringify(byAuthor),\n  generated_at: new Date().toISOString(),\n} }];\n"
      },
