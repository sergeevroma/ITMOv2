    {
      "parameters": {
        "jsCode": "const TEST_WEEK_START = \"\";\nconst now = $now.setZone(\"Europe/Moscow\");\nlet start = now.startOf(\"week\").minus({ weeks: 1 });\n\nif (TEST_WEEK_START) {\n  const [year, month, day] = TEST_WEEK_START.split(\"-\").map(Number);\n  start = now.set({ year, month, day }).startOf(\"day\");\n}\n\nconst end = start.plus({ weeks: 1 });\nreturn [{ json: {\n  week_start: start.toISODate(),\n  week_end: end.toISODate(),\n  from: start.toUTC().toISO(),\n  to: end.toUTC().toISO(),\n  is_test: Boolean(TEST_WEEK_START),\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
