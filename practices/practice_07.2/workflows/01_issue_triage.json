      "parameters": {
        "jsCode": "const issue = $(\"Issue trigger\").first().json.body.issue;\nconst classification = $input.first().json;\n\nconst accepted =\n  [\"bug\", \"task\", \"feature\"].includes(classification.type)\n  && classification.confidence >= 0.8;\n\nreturn [{\n  json: {\n    issue_id: String(issue.id),\n    issue_number: issue.number,\n    issue_url: issue.url,\n    author: issue.user.login,\n    type: accepted ? classification.type : \"unknown\",\n    confidence: classification.confidence,\n    is_first_time: issue.author_association === \"NONE\",\n  },\n}];\n"
      },
