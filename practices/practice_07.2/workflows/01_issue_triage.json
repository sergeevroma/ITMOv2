    {
      "parameters": {
        "jsCode": "const d = $(\"Decision\").first().json;\nconst repository = $(\"Issue trigger\").first().json.body.repository;\n\nconst replies = {\n  bug: \"Спасибо за описание. Обращение отмечено как ошибка.\",\n  feature: \"Спасибо за предложение. Оно отмечено как запрос новой возможности.\",\n  task:\n    \"Спасибо за вопрос. Команды и примеры запуска описаны в \"\n    + \"[README.md](https://github.com/sergeevroma/N8N_practice_2#readme).\",\n};\n\nconst contributingUrl =\n  `${repository.html_url}/blob/${repository.default_branch}/CONTRIBUTING.md`;\n\nconst welcome = d.is_first_time\n  ? `Привет, @${d.author}! Спасибо за участие.\\n\\n`\n    + `Правила проекта: [CONTRIBUTING.md](${contributingUrl}).\\n\\n`\n  : \"\";\n\nreturn [{ json: { body: welcome + replies[d.type] } }];\n"
      },
